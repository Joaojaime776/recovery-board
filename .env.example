# Copy to .env and fill in what you use. Nothing here is needed to run the demo.
PORT=3000

# When the daily sync runs (cron syntax, server local time). Default: every day at 06:00.
SYNC_CRON=0 6 * * *
# Timezone for the schedule (optional), e.g. America/Sao_Paulo
SYNC_TZ=

# Demo source with fictional clients. Turns on automatically when no real source is configured.
DEMO_MODE=

# Link to the source code, shown in the demo banner.
REPO_URL=

# Optional real integrations (not used by the public demo).
# Stripe: secret or restricted key with read access to Invoices
STRIPE_SECRET_KEY=
# Asaas: API key; use https://api-sandbox.asaas.com/v3 for sandbox
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
